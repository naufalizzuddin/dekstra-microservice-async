# Alternatif manual untuk smoke test docker-compose.loadtest.yml.
# Untuk pengujian resmi laporan, gunakan loadtest/run-scenario.ps1 atau
# loadtest/run-all.ps1 agar metadata, alokasi endpoint, CPU/RAM periodik, dan
# ringkasan fase spike ikut dibuat.
SBLT_TARGET=https://api.example.com
SBLT_PASSWORD=LoadTest!2026
SBLT_USERS=100
SBLT_SPAWN_RATE=10
SBLT_DURATION=300s
SBLT_RUN_ID=LT-01-manual
SBLT_HOST_HEADER=
SBLT_SCENARIO_KIND=manual
SBLT_ENDPOINT_ALLOCATIONS={"E-01":10,"E-02":8,"E-03":8,"E-04":8,"E-05":14,"E-06":14,"E-07":8,"E-08":14,"E-09":8,"E-10":8}
# Runner resmi memakai SBLT_ENDPOINT_ALLOCATIONS_B64 agar aman dari quoting
# PowerShell/Docker. Env JSON lama tetap didukung untuk smoke test manual.

# Gunakan SSH tunnel ke Prometheus pada VM target.
PROMETHEUS_URL=http://127.0.0.1:9090
