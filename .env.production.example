# Compose namespace. Keep this distinct from the monolith deployment.
COMPOSE_PROJECT_NAME=dekstra-microservice

# Public endpoint
DOMAIN=192.168.137.50
GATEWAY_BIND_ADDRESS=0.0.0.0
GATEWAY_PORT=8080
# Include the public host and Docker service names used by internal HTTP calls.
ALLOWED_HOSTS=192.168.137.50,localhost,127.0.0.1,user-api,document-api,approval-api,reporting-api
CSRF_TRUSTED_ORIGINS=http://192.168.137.50:8080
OTP_EXPOSE_IN_RESPONSE=0

# Generate with: openssl rand -base64 48
SECRET_KEY=replace-with-a-long-random-django-secret
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-token

# Use URL-safe passwords (letters and numbers) because Compose builds DATABASE_URL.
# Generate each value with: openssl rand -hex 24
REDIS_PASSWORD=replace-with-random-hex
USER_DB_PASSWORD=replace-with-random-hex
DOCUMENT_DB_PASSWORD=replace-with-random-hex
REPORTING_DB_PASSWORD=replace-with-random-hex

# Database names/users normally do not need changing.
USER_DB_NAME=user_db
USER_DB_USER=dekstra
DOCUMENT_DB_NAME=document_db
DOCUMENT_DB_USER=dekstra
REPORTING_DB_NAME=reporting_db
REPORTING_DB_USER=dekstra

# OTP email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=replace@example.com
EMAIL_HOST_PASSWORD=replace-with-an-app-password

# JWT
ACCESS_TOKEN_DAYS=3
REFRESH_TOKEN_DAYS=7

# Document metadata
KEPALA_DESA_NAMA=Nama Kepala Desa
KEPALA_DESA_NIP=1234567890
LIBREOFFICE_TIMEOUT_SECONDS=120

# Runtime tuning for a small VPS. Increase after measuring CPU/RAM.
USER_GUNICORN_WORKERS=2
REPORTING_GUNICORN_WORKERS=2
DOCUMENT_GUNICORN_WORKERS=2
APPROVAL_GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
OTP_WORKER_CONCURRENCY=1
DOCUMENT_WORKER_CONCURRENCY=1
PROJECTION_WORKER_CONCURRENCY=1
NOTIFICATION_WORKER_CONCURRENCY=1
DB_CONN_MAX_AGE=60

# Optional monitoring overlay
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# Start conservatively. Increase HSTS only after HTTPS is confirmed stable.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
